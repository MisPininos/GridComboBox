<Window x:Class="GridComboBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GridComboBox"
        xmlns:converters="clr-namespace:GridComboBox.Views.Converters"
        xmlns:helpers="clr-namespace:GridComboBox.Views.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <!--Converters-->
        <converters:RoleToStringConverter x:Key="Views.Converters.RoleToStringConverter"/>
        
        <!--Selected Template Name-->
        <DataTemplate x:Key="SelectedUserNameTemplate">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
        </DataTemplate>
        
        <!--Selected Template Email-->
        <DataTemplate x:Key="SelectedUserEmailTemplate">
            <TextBlock Text="{Binding Email}" VerticalAlignment="Center"/>
        </DataTemplate>

        <!--Drop Down User Template-->
        <DataTemplate x:Key="DropDownUserTemplate">
            <Grid Width="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Email}" Grid.Column="1" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Role, Converter={StaticResource Views.Converters.RoleToStringConverter}}"
               Grid.Column="2"
               VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        
        <!--Helpers-->
        <helpers:ComboBoxUserTemplateSelector x:Key="Helpers.ComboBoxUserNameTemplateSelector"
                                                SelectedTemplate="{StaticResource SelectedUserNameTemplate}"
                                                DropDownTemplate="{StaticResource DropDownUserTemplate}"/>

        <helpers:ComboBoxUserTemplateSelector x:Key="Helpers.ComboBoxUserEmailTemplateSelector"
                                              SelectedTemplate="{StaticResource SelectedUserEmailTemplate}"
                                                DropDownTemplate="{StaticResource DropDownUserTemplate}"/>
    </Window.Resources>
    
    <StackPanel VerticalAlignment="Center">
        <ComboBox ItemsSource="{Binding Users}" 
                  Width="300" Height="30"
                  ItemTemplateSelector="{StaticResource Helpers.ComboBoxUserNameTemplateSelector}"
                  SelectedItem="{Binding SelectedUser}"/>
        
        <ComboBox ItemsSource="{Binding Users}" 
                  Width="300" Height="30"
                  ItemTemplateSelector="{StaticResource Helpers.ComboBoxUserEmailTemplateSelector}"
                  SelectedItem="{Binding SelectedUser}"/>


    </StackPanel>
</Window>
