<Window x:Class="GridComboBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GridComboBox"
        xmlns:converters="clr-namespace:GridComboBox.Views.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <!--Converters-->
        <converters:RoleToStringConverter x:Key="Views.Converters.RoleToStringConverter"/>
        
        <!--Selected Template-->
        <DataTemplate x:Key="SelectedUserTemplate">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
        </DataTemplate>

        <!--Drop Down User Template-->
        <DataTemplate x:Key="DropDownUserTemplate">
            <Grid Width="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Email}" Grid.Column="1" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Role, Converter={StaticResource Views.Converters.RoleToStringConverter}}"
               Grid.Column="2"
               VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <ComboBox ItemsSource="{Binding Users}" 
                  Width="300" Height="30"
                  ItemTemplate="{StaticResource DropDownUserTemplate}"/>


    </Grid>
</Window>
